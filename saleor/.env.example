# Copia este archivo a .env (cp .env.example .env). Valores solo para desarrollo local.

# --- Versión de Saleor (API, worker y dashboard deben coincidir) ---
SALEOR_VERSION=3.23

# --- Postgres ---
POSTGRES_USER=saleor
POSTGRES_PASSWORD=saleor
POSTGRES_DB=saleor
# Cambia el puerto si ya tienes otro Postgres escuchando en el 5432
POSTGRES_HOST_PORT=5432

# --- Saleor API y worker ---
DATABASE_URL=postgres://saleor:saleor@db:5432/saleor
CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1
SECRET_KEY=changeme-solo-local
DEFAULT_CHANNEL_SLUG=default-channel
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_URL=smtp://mailpit:1025

# Permite que apps que corren en tu máquina (localhost) reciban webhooks de Saleor.
# En producción: HTTP_IP_FILTER_ENABLED=True y HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=False
HTTP_IP_FILTER_ENABLED=False
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True

# --- Trazas (Jaeger) ---
OTEL_SERVICE_NAME=saleor
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
